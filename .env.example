# Provider selection (priority order):
#   1. TUTOR_CLAUDE_CLI set       -> Claude via the `claude` CLI (your Claude
#                                    Code login / subscription — no API key)
#   2. ANTHROPIC_API_KEY set      -> Claude (claude-opus-4-8)
#   3. TUTOR_LOCAL_LLM_URL set    -> local Gemma 12B (OpenAI-compatible server)
#   4. none                       -> built-in deterministic mock (zero config)

# 0) Use your existing Claude Code login instead of an API key. Set to 1 (uses
#    `claude` from PATH) or a full path to the binary. Requires Claude Code
#    installed and logged in (`claude` once, interactively). Leave ANTHROPIC_API_KEY
#    BLANK — the CLI prefers an API key over your subscription when one is set.
#    Quickstart: `make dev-claude-code`
TUTOR_CLAUDE_CLI=
TUTOR_CLAUDE_CLI_MODEL=sonnet
# Optional extra flags passed to `claude -p` (e.g. "--permission-mode plan").
TUTOR_CLAUDE_CLI_ARGS=

# 1) Real Claude via API. Leave blank to skip.
ANTHROPIC_API_KEY=

# 2) Local fallback — point at an Ollama / llama.cpp / LM Studio server.
#    Ollama example:
#      ollama pull gemma2:12b
#      TUTOR_LOCAL_LLM_URL=http://localhost:11434/v1
#      TUTOR_LOCAL_LLM_MODEL=gemma2:12b
TUTOR_LOCAL_LLM_URL=
TUTOR_LOCAL_LLM_MODEL=gemma2:12b
# Optional bearer token for servers that require one (LM Studio, vLLM, etc.).
TUTOR_LOCAL_LLM_KEY=

# Where documents (markdown + json + assets) are persisted.
TUTOR_DATA_DIR=./data

# API server port.
PORT=8787
